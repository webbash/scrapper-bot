[Unit]
Description=Scrapper Bot one-shot Bazaraki sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=no
User=scrapper-bot
Group=scrapper-bot
StateDirectory=scrapper-bot
StateDirectoryMode=0700
WorkingDirectory=/var/lib/scrapper-bot
EnvironmentFile=/etc/scrapper-bot/bot.env
ExecStart=/opt/scrapper-bot/bazaraki-html sync
KillSignal=SIGINT
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
